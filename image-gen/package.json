{
    "name": "image-gen",
    "version": "0.1.0",
    "description": "CLI for generating images with Google's Gemini image models, over Vertex AI or the Gemini API",
    "type": "module",
    "private": true,
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "auth": "bun run scripts/auth.ts",
        "generate": "bun run scripts/generate.ts"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/bun": "^1.3.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.0.0",
        "prettier": "^3.0.0",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.0.0"
    },
    "dependencies": {
        "@google/genai": "^2.19.0",
        "@inquirer/prompts": "^8.5.2",
        "commander": "^15.0.0"
    }
}
